# API de NASA DONKI (https://api.nasa.gov/)
# Solo la necesita el listener NASA; --ai-only y --ai-once no la usan.
# Si ya tienes API_NASA_KEY en api.env, deja esta línea comentada.
# El código también acepta el nombre NASA_API_KEY.
# API_NASA_KEY=tu_api_key_de_nasa

# Postgres de Supabase: Project Settings -> Database -> Connection string.
# Usa la conexión directa o el Session pooler (puerto 5432), no el Transaction
# pooler (6543): SQLx usa prepared statements y el pooler transaccional no los
# soporta. Codifica la contraseña si tiene caracteres especiales.
DATABASE_URL=postgresql://postgres.tu-proyecto:[TU_PASSWORD]@aws-0-tu-region.pooler.supabase.com:5432/postgres

# 2 = consulta ayer y hoy (UTC). 3 = anteayer, ayer y hoy.
DIAS_VENTANA=2

# Cada cuántos minutos se ejecuta un ciclo.
INTERVALO_MINUTOS=60

# true = consulta NASA y muestra los eventos por consola sin escribir en la base de datos.
DRY_RUN=false

# --- Worker de IA (cualquier proveedor compatible con OpenAI chat/completions) ---
AI_ENABLED=true
AI_MIN_MINUTOS=15
AI_MAX_MINUTOS=60

# URL completa del endpoint de chat.
AI_API_URL=https://api.deepseek.com/chat/completions

# Modelo del proveedor.
AI_MODEL=deepseek-chat

# Si ya tienes AI_API_KEY (o API_IA_KEY) en api.env, deja esta línea comentada.
# AI_API_KEY=tu_api_key

# Prompt personalizado opcional. Si no se define, se usa contexto_ia.md.
# Si contiene {evento}, se reemplaza por el JSON.
# AI_PROMPT=Eres el narrador de un juego espacial. Devuelve JSON con mensaje y explicacion para este evento: {evento}

# true = pide al proveedor respuesta JSON (mensaje + explicacion).
AI_JSON_MODE=true
AI_MAX_TOKENS=700
AI_TEMPERATURE=0.8
AI_TIMEOUT_SEGUNDOS=120
AI_PENDING_LIMIT=500

# --- Integración con el juego Mission Trainer (vía relay WebSocket) ---
# true = manda el evento (con su mecánica y el mensaje de la IA) al juego cuando la IA
# genera un mensaje.
JUEGO_ENABLED=false

# URL del relay WebSocket (por defecto el servicio desplegado en Render).
JUEGO_RELAY_URL=wss://mission-trainer-relay.onrender.com

# Destino de los eventos (elige uno):
# - Todas las salas: la clave de difusión del relay
#   (Render -> mission-trainer-relay -> Environment -> DIFUSION_CLAVE).
# DIFUSION_CLAVE=
# - Una sola sala (3 a 40 caracteres: letras, números, - o _). Tiene prioridad.
#   Abre el juego con ?sala=CODIGO.
# JUEGO_SALA=mi-sala-1

# Dificultad con la que el juego ejecuta el evento: Fácil, Normal, Difícil o Extremo.
JUEGO_DIFICULTAD=Normal

# Color del texto mostrado en la pantalla del juego (hex, por defecto amarillo).
JUEGO_COLOR=#ffcc00

# Duración en segundos que permanece visible el mensaje en el juego (por defecto 8).
JUEGO_SEGUNDOS=8

# --- Servidor MCP de Mission Trainer (puente Claude <-> juego) ---
# URL del relay usada por mcp/servidor_mcp.py (por defecto el de Render).
# MISSION_RELAY=wss://mission-trainer-relay.onrender.com

# Codigo de sala por defecto para el servidor MCP (opcional; si no, Claude usa la
# herramienta conectar_sala).
# MISSION_SALA=mi-sala-1

# Supabase (solo para la herramienta leer_eventos del servidor MCP).
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_KEY=tu_service_key
